{"nodes": [{"id": "docs_features_query_tab", "label": "Query tab feature (query-tab.md)", "file_type": "document", "source_file": "docs/features/query-tab.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_query_tab_query_view", "label": "Query view TabViewQuery (filter/sort/projection inputs, Execute/Cancel, limit 10-200, Refresh, table/JSON switch, runs on open)", "file_type": "concept", "source_file": "docs/features/query-tab.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_query_tab_paging", "label": "Paging repeats the last executed query with another skip (\"51-100 of 1,234\", \"~\" marks an estimate)", "file_type": "rationale", "source_file": "docs/features/query-tab.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typing does not change what the next page means."}, {"id": "docs_features_query_tab_parse_query_texts", "label": "parseQueryTexts: empty or { } means none; a parse error names the input and nothing is sent", "file_type": "concept", "source_file": "docs/features/query-tab.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_query_tab_mongo_autocomplete", "label": "MongoDB autocomplete in the single-line CodeMirror QueryInput (operators, shell functions, field names of the last result)", "file_type": "concept", "source_file": "docs/features/query-tab.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_query_tab_shell_query_parser", "label": "Shell-syntax query parser (generateTokens + createParser().parseQuery: unquoted and dotted keys, single quotes, regex literals, trailing comma)", "file_type": "concept", "source_file": "docs/features/query-tab.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON does not allow unquoted keys, single quotes and shell functions; the history gives no reason for not using a library."}, {"id": "docs_features_query_tab_shell_function_mapping", "label": "Checked shell function -> extended JSON mapping (ObjectId -> $oid, ISODate/Date -> $date UTC, NumberLong/Int/Decimal, Timestamp, BinData/UUID -> $binary, RegExp -> $regularExpression)", "file_type": "rationale", "source_file": "docs/features/query-tab.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What bson cannot read silently matched nothing (e.g. ISODate(\"2024-01-01\"), which bson only reads as a full RFC 3339 date)."}, {"id": "docs_features_query_tab_extended_json_format", "label": "Extended JSON as the UI-Rust query interchange format (FindQuery; bson turns it into BSON types)", "file_type": "rationale", "source_file": "docs/features/query-tab.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_query_tab_bson_regex", "label": "A regex is sent as a BSON regex, not the $regex operator, so it also works inside $in", "file_type": "rationale", "source_file": "docs/features/query-tab.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_query_tab_find_and_count", "label": "find (filter, sort, projection, skip, limit 1-10000, allowDiskUse) with a concurrent count: estimatedDocumentCount for an empty filter, countDocuments otherwise", "file_type": "rationale", "source_file": "docs/features/query-tab.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counting a big collection with countDocuments scans it; the UI marks the number as estimate."}, {"id": "docs_features_query_tab_unsupported_syntax", "label": "Find only: no aggregation, explain, $where, comments, NumberDouble, MinKey or MaxKey", "file_type": "concept", "source_file": "docs/features/query-tab.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_query_tab_estimate_inaccuracy", "label": "Estimated count may be off (after an unclean shutdown, on a sharded cluster)", "file_type": "concept", "source_file": "docs/features/query-tab.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_features_query_tab", "target": "docs_features_query_tab_query_view", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/features/query-tab.md", "source_location": null, "weight": 1.0}, {"source": "docs_features_query_tab", "target": "docs_features_query_tab_paging", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/features/query-tab.md", "source_location": null, "weight": 1.0}, {"source": "docs_features_query_tab", "target": "docs_features_query_tab_parse_query_texts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/features/query-tab.md", "source_location": null, "weight": 1.0}, {"source": "docs_features_query_tab", "target": "docs_features_query_tab_mongo_autocomplete", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/features/query-tab.md", "source_location": null, "weight": 1.0}, {"source": "docs_features_query_tab", "target": "docs_features_query_tab_shell_query_parser", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/features/query-tab.md", "source_location": null, "weight": 1.0}, {"source": "docs_features_query_tab", "target": "docs_features_query_tab_shell_function_mapping", "relation": "referen