{"nodes": [{"id": "docs_features_connect_and_explorer", "label": "Connect and explorer feature (connect-and-explorer.md)", "file_type": "document", "source_file": "docs/features/connect-and-explorer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_connect_and_explorer_connect_flow", "label": "Connect flow (connectTo -> start_connect task -> ConnectionHandler.open -> list databases; a failed first command drops the driver)", "file_type": "rationale", "source_file": "docs/features/connect-and-explorer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The client connects lazily, so listing is the first contact with the server; the grid gives way only once a connection is connected (issue #27)."}, {"id": "docs_features_connect_and_explorer_driver_pool", "label": "Driver pool: one DatabaseDriver per connection id, shared without a lock (locked only to look up and insert, not while a driver loads its password and connects); dropped on disconnect, edit, delete or a failed first command", "file_type": "rationale", "source_file": "docs/features/connect-and-explorer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The mongodb client runs several commands of one connection at once, so a slow query in one tab does not hold up another tab or the sidebar. Reused across commands, and dropped when it may be wrong because it is created before the server is contacted (issue #25)."}, {"id": "docs_features_connect_and_explorer_explorer_sidebar", "label": "Explorer sidebar (AppSidebar: node per open connection with refresh/edit/disconnect, lazily listed and cached collections, active-tab highlight)", "file_type": "concept", "source_file": "docs/features/connect-and-explorer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_connect_and_explorer_list_databases_privilege", "label": "Connecting needs the right to list databases; no field to name a database directly", "file_type": "concept", "source_file": "docs/features/connect-and-explorer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_connect_and_explorer_no_session_restore", "label": "Open connections and tabs are not restored after a restart", "file_type": "concept", "source_file": "docs/features/connect-and-explorer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_connect_and_explorer_server_selection_timeout", "label": "A host that does not answer waits for the server selection timeout (the connection's option, else the driver's 30 s) unless the user cancels", "file_type": "concept", "source_file": "docs/features/connect-and-explorer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_connect_and_explorer_sessions", "label": "Connection sessions (connectionStore.sessions: status, databases, cached collections, refreshing; one per open connection)", "file_type": "concept", "source_file": "docs/features/connect-and-explorer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_features_connect_and_explorer_connect_flow", "target": "docs_features_background_tasks_task_pattern", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/features/connect-and-explorer.md", "source_location": null, "weight": 1.0}, {"source": "docs_features_connect_and_explorer", "target": "docs_features_background_tasks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/features/connect-and-exp