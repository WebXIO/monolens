{"nodes": [{"id": "docs_architecture_decisions", "label": "Decision log (decisions.md)", "file_type": "document", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_decisions_smtp_relay", "label": "smtp-relay (sibling project used as template)", "file_type": "concept", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_decisions_driver_trait_factory", "label": "Decision: DatabaseDriver trait with a factory per ConnectorKind", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leaves room for more drivers or a second MongoDB implementation (2026-02-05, 4100b21); the commit only lists the parts."}, {"id": "docs_architecture_decisions_dependency_injection", "label": "Decision: dependency injection on both sides (Tauri managed state, provider registry)", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Services are created once and can be swapped behind an interface (ConnectionService, ConnectionRepository, LogStrategy); no further reason recorded."}, {"id": "docs_architecture_decisions_tauri_vue_stack", "label": "Decision: Tauri 2 with a Rust core and a Vue 3 web view", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "README calls Rust/Tauri a high-performance backend with secure system-level access and Vue/Tailwind modern and maintainable; goal is a free European alternative to Studio 3T."}, {"id": "docs_architecture_decisions_no_credentials_in_logs", "label": "Decision: no credentials in logs; URI logged only in debug builds with masked password", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The URI carries the password (8d6bcac, PR #32)."}, {"id": "docs_architecture_decisions_edit_dialog_shows_password", "label": "Decision: edit dialog shows the stored password, fetched from the keyring on open", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users wanted to see and fix the password they saved (issue #29); partly reverses PR #23. Rejected: keeping the password write-only."}, {"id": "docs_architecture_decisions_optional_connection_test", "label": "Decision: testing a connection is optional before saving", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Issue #26 gives no reason. Rejected: requiring a successful test before saving."}, {"id": "docs_architecture_decisions_credentials_stay_in_rust", "label": "Decision: credentials stay in Rust; get_connections/get_connection never return a password", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passwords should not be exposed to the web view and listing should not hit the keyring per connection (PR #23, issue #24). Rejected: hydrating passwords when listing."}, {"id": "docs_architecture_decisions_versioned_storage", "label": "Decision: connections stored as a versioned JSON map keyed by id", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O(1) access by id and a version to migrate the file when its shape changes (issue #24). Rejected: a plain array of connections."}, {"id": "docs_architecture_decisions_linux_keyring_backend", "label": "Decision: Linux keyring via linux-native-sync-persistent with vendored OpenSSL", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "keyutils for fast kernel-level access during a session, Secret Service for persistence; vendored bundles the OpenSSL the Linux backend needs. Rejected: sync-secret-service alone."}, {"id": "docs_architecture_decisions_os_keyring", "label": "Decision: passwords stored in the OS keyring through the keyring crate", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses the native store on Windows, macOS and Linux (issue #15). Rejected: Tauri Stronghold, added 2026-02-15 and reverted 2026-02-17 as \"not needed anymore\"."}, {"id": "docs_architecture_decisions_url_percent_encoding", "label": "Decision: password set on the URL with Url::set_password (percent-encoded)", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passwords with special characters failed with \"password must be URL encoded\" (issue #21)."}, {"id": "docs_architecture_decisions_basic_auth_only", "label": "Decision: only basic authentication (username, password, auth database) for the MVP", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\"For MVP, Basic is sufficient\" (issue #3). Rejected: other mechanisms for now."}, {"id": "docs_architecture_decisions_toasts", "label": "Decision: errors shown as vue-sonner toasts instead of per-component error boxes", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cleaner, less duplicated code and styling, fits the theme (issue #36). Rejected: the error boxes of before."}, {"id": "docs_architecture_decisions_background_tasks", "label": "Decision: testing, connecting and finding run as cancellable background tasks with an id", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A slow connection froze the UI and there was no way to give up (issue #27). Rejected: a timeout only."}, {"id": "docs_architecture_decisions_streamed_test_stages", "label": "Decision: the connection test streams each stage as a Tauri event", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each stage shows when it really finishes, not all at once (a14c8fc)."}, {"id": "docs_architecture_decisions_user_message_errors", "label": "Decision: every error carries kind, message and user_message; UI shows user_message", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw driver errors were long and unreadable (issue #16). Rejected: showing the raw error."}, {"id": "docs_architecture_decisions_driver_per_connection", "label": "Decision: one driver per connection id kept for the life of the process", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuse the MongoDB client's connection pool across commands (1f358d4); no further reason recorded."}, {"id": "docs_architecture_decisions_virtualized_table", "label": "Decision: table renders only visible rows, caches formatted cells, sizes columns from a sample", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bigger result sets render fast (0aca486, PR #44, issue #39)."}, {"id": "docs_architecture_decisions_table_default_view", "label": "Decision: table is the default view; column order saved per connection, database and collection", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The commit (ead8967) gives no reason for the default."}, {"id": "docs_architecture_decisions_codemirror_query_input", "label": "Decision: query input is a single-line CodeMirror editor with MongoDB autocomplete", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The history gives no reason (9f677e1)."}, {"id": "docs_architecture_decisions_own_query_parser", "label": "Decision: shell-style queries parsed by an own parser into extended JSON", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepts unquoted keys, single quotes and shell functions like ObjectId(...) that JSON doesn't; bson turns the extended JSON into BSON in Rust. No recorded reason for not using a library."}, {"id": "docs_architecture_decisions_tabs_stay_mounted", "label": "Decision: open tabs stay mounted (v-show and KeepAlive)", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Switching tabs lost the state (573dfc0). Rejected: v-if."}, {"id": "docs_architecture_decisions_bundled_roboto", "label": "Decision: Roboto bundled with the app", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The font of the built app looked wrong (issue #30). Rejected: the system font."}, {"id": "docs_architecture_decisions_window_size", "label": "Decision: default window is 1200 x 900", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The history gives no reason (b35246a)."}, {"id": "docs_architecture_decisions_docs_and_working_rules", "label": "Decision: docs/ documents features, architecture, decisions and plans; CLAUDE.md holds working rules", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The project is being revived: its state had to be written down first, and work should follow the same rules as the other projects (as in smtp-relay)."}, {"id": "docs_architecture_decisions_graphify_knowledge_graph", "label": "Decision: graphify knowledge graph; only the semantic cache is committed", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same setup as smtp-relay: the cache saves the model cost of re-reading docs, and graph.json is rewritten whole on every rebuild. Rejected: committing graph.json, ignoring graphify-out/ completely."}, {"id": "docs_architecture_decisions_branching_model", "label": "Decision: feature branches off develop merged by pull requests; develop goes to main from time to time", "file_type": "rationale", "source_file": "docs/architecture/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The history records no reason."}], "edges": [{"source": "docs_architecture_decisions", "target": "docs_architecture_decisions_driver_trait_factory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/decisions.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_decisions_driver_trait_factory", "target": "src_tauri_src_drivers_driver_databasedriver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/decisions.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_decisions_driver_trait_factory", "target": "src_tauri_src_drivers_factory_databasedriverfactory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/decisions.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_decisions_driver_trait_factory", "target": "src_tauri_src_connector_models_connection_connectorkind", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/decisions.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_decisions", "target": "docs_architecture_decisions_dependency_injection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/decisions.md", "