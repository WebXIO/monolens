{"nodes": [{"id": "claude", "label": "CLAUDE.md (working guide)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_keep_in_sync_rules", "label": "Keep-in-sync rules", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feature, command, model, test-stage, plan and setup changes must update their mirrors (feature doc, command table, generate_handler!, ConnectionServiceIPC wrapper, TypeScript models, STORAGE_VERSION) so docs and both sides of IPC do not drift."}, {"id": "claude_testing_policy", "label": "Unit tests for every piece of logic", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every piece of logic gets unit tests for regular and edge cases; logic is pulled out of components into composables/utils so it can be tested without mounting, and MongoDB/keyring are abstracted behind traits in Rust tests."}, {"id": "claude_untested_hotspots", "label": "Untested code worth covering when touched", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_git_workflow", "label": "Git workflow (feature branches off develop, /code-review before push, lowercase conventional commits)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no CI, so pnpm test:frontend, pnpm build and cargo check run locally before pushing; commit bodies explain why and end with \"refers to #<issue>\"; no Claude co-author trailers."}, {"id": "claude_coding_conventions", "label": "Coding conventions (match file indentation, @/ alias, thiserror, spawn_blocking for keyring)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Match the file being edited; comments are short and explain why, not what."}, {"id": "claude_model_mirroring", "label": "TypeScript models mirror Rust structs (camelCase fields, enum values = Rust variant names)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both sides of the IPC boundary must agree on the serialized shape, so a model change is made on both sides together."}, {"id": "claude_driver_method_recipe", "label": "Adding database work: DatabaseDriver method -> MongoDbOfficialDriver -> task command", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DatabaseDriver is the seam for database work; new slow work follows start_connect.rs as a task command."}, {"id": "claude_logging_rule", "label": "Log with useLogger, never console.*; never log credentials", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_shortcut_recipe", "label": "Adding a shortcut: command id, register, bind", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_graphify_rules", "label": "graphify query-first rules", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify query/path/explain return a scoped subgraph much smaller than GRAPH_REPORT.